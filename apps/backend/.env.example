NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://crowdpulse:crowdpulse_dev_password@localhost:5433/crowdpulse?schema=public"

# Minimal 32 karakter, acak. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret_min_32_chars
JWT_EXPIRES_IN_SECONDS=3600
QR_SECRET=CHANGE_ME_generate_another_random_secret_min_32_chars

PAYMENT_SIMULATION_ENABLED=true
ORDER_EXPIRY_MINUTES=15
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=10

THROTTLE_CHECKIN_LIMIT=300

# Lokasi penyimpanan foto pemegang tiket (di luar folder publik). Jangan di-commit.
UPLOAD_DIR=./storage/photos

# Batas tiket per akun per acara (order PAID + PENDING yang belum kedaluwarsa)
MAX_TICKETS_PER_USER_PER_EVENT=5

# Batas request ingest kamera analitik per menit (per IP)
THROTTLE_INGEST_LIMIT=600

# Masa tenggang (menit) setelah endAt sebelum acara PUBLISHED otomatis menjadi FINISHED
EVENT_AUTO_FINISH_GRACE_MINUTES=0
